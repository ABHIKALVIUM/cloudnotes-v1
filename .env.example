# CloudNotes Environment Configuration Example
# Copy this file to .env and adjust variables for your target deployment environment.
# IMPORTANT: Never commit the production .env file with live secrets to Git.

# Application Runtime Configuration
FLASK_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key
HOST=0.0.0.0
PORT=5000

# File Upload Storage Directory
UPLOAD_FOLDER=/home/cloudnotes/cloudnotes/uploads

# Database Configuration
# PostgreSQL connection string format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://cloudnotes:cloudnotes_password@localhost:5432/cloudnotes_db

# Fallback SQLite configuration (for local quick test only):
# DATABASE_URL=sqlite:////home/cloudnotes/cloudnotes/database/cloudnotes.db
